{
  "name": "storytape-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first audiobook recorder and player PWA with offline-first storage and Google Drive sync",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:formal": "vitest run --config vitest.formal.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "precheck": "npm run typecheck && npm test && npm run test:formal && npm run build && PRECHECK=1 npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "mp4-muxer": "^5.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "webm-muxer": "^5.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3",
    "z3-solver": "^5.4.1"
  }
}
