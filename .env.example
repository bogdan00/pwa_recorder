# Optional: Pre-configure your Google Cloud OAuth 2.0 Web Client ID at build time.
# You can also enter or override this directly inside Settings -> Google Drive in the app.
VITE_GOOGLE_CLIENT_ID=

# Optional: Override deployment base path (defaults to /pwa_recorder/ in production builds).
# Set to "/" if deploying to a custom root domain.
VITE_BASE_PATH=/pwa_recorder/
